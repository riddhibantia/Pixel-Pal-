rules_version = '2';

// PixelPal Firestore security rules — least privilege per collection.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Companion is a single doc per user (users/{uid}/companion/data)
      match /companion/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Tasks keyed by stable cloudId UUID — never auto-inc id
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /subtasks/{subId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
      match /reminders/{remId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Activity/bond/personality are local-only; deny cloud writes if ever created
      match /{other=**} {
        allow read, write: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
